# ========================================================
# Vanta Services - Environment Variables Configuration
# ========================================================

# Database (MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=vanta_services

# Security & Authentication
JWT_SECRET=vanta-super-secret-key-change-this-in-production-2026

# DHRU Fusion API Integration
DHRU_API_URL=https://dhru.example.com/api
DHRU_USERNAME=vanta_admin
DHRU_API_KEY=your_dhru_api_access_key

# Payment Gateways Setup
VODAFONE_CASH_RECEIVER=01012345678
INSTAPAY_USERNAME=vanta@instapay
BINANCE_PAY_ID=894123567

# App Settings
NEXT_PUBLIC_SITE_NAME=Vanta Services
DEFAULT_EXCHANGE_RATE=50.00
